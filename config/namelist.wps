&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2026-08-12_12:00:00','2026-08-12_12:00:00',
 end_date   = '2026-08-13_06:00:00','2026-08-13_06:00:00',
 interval_seconds = 3600,
 io_form_geogrid = 2,
/

&geogrid
 parent_id         =   1,
 parent_grid_ratio =   1,
 i_parent_start    =   1,
 j_parent_start    =   1,
 e_we              = 301,
 e_sn              = 301,
 geog_data_res     = 'default',
 dx = 1000,
 dy = 1000,
 map_proj = 'lambert',
 ref_lat   =  33.45,
 ref_lon   = -112.07,
 truelat1  =  33.45,
 truelat2  =  33.45,
 stand_lon = -112.07,
 geog_data_path = '/home/kenny/phoenix-wrf/geog/',
 opt_geogrid_tbl_path = '/home/kenny/phoenix-wrf/src/WPS/geogrid/',
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE','SFC',
 io_form_metgrid = 2,
 opt_metgrid_tbl_path = '/home/kenny/phoenix-wrf/src/WPS/metgrid/',
/
